APP_NAME="بيتك في ايدك"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=ar_EG

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# ---- MySQL ----
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bayetak_fi_eidak
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=public
MAIL_MAILER=log

# ---- بيانات المنصة ----
SITE_PHONE="+20 100 000 0000"
SITE_WHATSAPP=201000000000
SITE_EMAIL=info@turathcode.com

# ---- نسبة المنصة (العمولة) من كل طرف عند إتمام الاتفاق ----
COMMISSION_OWNER_PERCENT=5
COMMISSION_TENANT_PERCENT=5
